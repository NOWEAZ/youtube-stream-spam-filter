# Copy this example to .env; the backend loads .env automatically. Process variables win.
# OPENCODE_API_KEY=your-opencode-console-api-key
# OPENCODE_PROVIDER=zen
# OPENCODE_MODEL=minimax-m3.1-flash
# zen: pay-as-you-go Console API (formerly Zen); default for this app.
# go: Go subscription endpoint; designed for coding agents. Confirm eligibility first.
# YCSF_TOKEN=optional-custom-pairing-token-at-least-24-characters
